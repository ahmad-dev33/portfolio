# Copy to .env and fill in (backend/.env is git-ignored, never commit secrets)
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Comma-separated. Add your Render/Railway domain + keep localhost for testing
ALLOWED_HOSTS=localhost,127.0.0.1,your-backend.onrender.com
# Your deployed React app URL (no trailing slash) — used for CORS/CSRF
# e.g. https://ahmaddana.liveblog365.com
FRONTEND_URL=https://your-frontend.vercel.app
# Optional extra origins + trusted CSRF origins
CORS_EXTRA_ORIGINS=
CSRF_TRUSTED_ORIGINS=
# Optional: Postgres URL from your host (leave empty = sqlite)
DATABASE_URL=
# Cookie flags: leave empty for auto (Secure+SameSite=None in prod https, Lax locally)
COOKIE_SECURE=
COOKIE_SAMESITE=

# Gmail: use an App Password (https://myaccount.google.com/apppasswords)
# Enable 2-Step Verification first, then create an App Password for "Mail".
EMAIL_HOST_USER=youremail@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Where contact messages are emailed to (e.g. yourname@gmail.com)
CONTACT_EMAIL_TO=youremail@gmail.com
